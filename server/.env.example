PORT=3001
CLIENT_ORIGIN=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-only-secret-key
JWT_SECRET=replace-with-a-long-random-secret
LOG_LEVEL=info

# IA — clé Google AI Studio (Gemini Developer API), jamais exposée au client.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Repli facultatif lorsque Gemini est indisponible.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Chaîne PostgreSQL Supabase (mode Session pooler recommandé) pour les checkpoints LangGraph.
DATABASE_URL=
AI_DAILY_REQUEST_LIMIT=20
AI_PROVIDER_TIMEOUT_MS=90000

# Observabilité facultative LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=maxcanva
